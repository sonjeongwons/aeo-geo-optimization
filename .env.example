# ============================================================
# AEO/GEO Engine — Environment Variables
# Copy to .env and fill in values. DATABASE_URL is required.
# GEMINI_API_KEY is the only required provider key for Phase 0.
# ============================================================

# ---- Required ----
DATABASE_URL=postgres://aeo:aeo_secret@localhost:5432/aeo_geo

# ---- Provider Keys ----
# GEMINI_API_KEY is the ONLY required provider key for Phase 0.
# All other provider keys are optional; those adapters will return NOT_CONFIGURED.
GEMINI_API_KEY=

# Optional provider keys (stubs return NOT_CONFIGURED when absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
LLAMA_GROQ_API_KEY=

# ---- Grounding cost control (optional) ----
# GEMINI_GROUNDING=on            # ground EVERY Gemini call (bills the Search tool; validation only)
# GEMINI_GROUNDING_SAMPLE_PCT=3  # otherwise ground ~N% of work-units (bounded Search spend)

# ---- App Config ----
LOG_LEVEL=info
PORT=3000

# ---- Cost Guardrails ----
# Global fallback USD caps (per-customer caps override these in the budget table)
GLOBAL_WEEKLY_USD_CAP=50
GLOBAL_MONTHLY_USD_CAP=150

# ---- Alert Thresholds ----
# Fraction of USD cap that triggers a cost alert (0.8 = 80%)
COST_ALERT_THRESHOLD=0.8
